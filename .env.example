# ----- Backend -----
APP_ENV=development
DATA_DIR=./data
MODEL_DIR=./models

# Cron cho APScheduler (UTC). Mặc định: Chủ Nhật 00:00 hàng tuần.
TRAIN_SCHEDULE_CRON=0 0 * * 0

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000/api
